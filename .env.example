# ===========================================================================
# Mahajan Hedge Fund - API Keys (Layer 1)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the keys you have. The provider
# abstraction layer auto-selects the best available source based on which
# keys are present. All keys are OPTIONAL: with none set, the platform runs
# entirely on free sources (yfinance + SEC EDGAR).
# ===========================================================================

# Polygon.io -> preferred for prices (https://polygon.io)
POLYGON_API_KEY=

# Financial Modeling Prep -> structured financials + earnings transcripts
FMP_API_KEY=

# FRED (St. Louis Fed) -> macro / regime data
FRED_API_KEY=

# Contact email embedded in the SEC EDGAR User-Agent (required by SEC fair-access).
SEC_CONTACT_EMAIL=manitm204@gmail.com
